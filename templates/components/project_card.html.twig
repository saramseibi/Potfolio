<div class="group bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">


{% if project.image %}
        <img
        src="{{ asset('uploads/projects/' ~ project.image) }}"
        alt="{{ project.title }}"
        class="w-full h-48 md:h-52 object-cover rounded-t-2xl
  transition-transform duration-500 group-hover:scale-105"

        />
    {% else %}
        <div class="w-full h-48 md:h-52 bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center rounded-t-2xl">
            <i class="fas fa-project-diagram text-6xl text-white opacity-40"></i>
        </div>

{% endif %}

    <div class="p-6">
        <h3 class="text-lg font-semibold mb-2 text-gray-900 tracking-tight">{{ project.title }}</h3>
        <div x-data="{ open: false }" class="mb-4">
            <p class="text-gray-600 text-sm leading-relaxed">

        <span x-show="!open">
            {{ project.description|slice(0, 140) }}{% if project.description|length > 140 %}...{% endif %}
        </span>

                <span x-show="open">
            {{ project.description }}
        </span>
            </p>

            {% if project.description|length > 140 %}
                <button
                    @click="open = !open"
                    class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-blue-600 hover:gap-2 transition-all duration-300">
                    <span x-show="!open">Read more</span>
                    <span x-show="open">Read less</span>
                </button>
            {% endif %}
        </div>


        {% if project.technologies %}
            <div class="flex flex-wrap gap-2 mb-4">
                {% for tech in project.technologies|split(',') %}
                    <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-600 hover:bg-blue-100 transition">

                        {{ tech|trim }}
                    </span>
                {% endfor %}
            </div>
        {% endif %}

        <div class="flex justify-between items-center pt-4 border-t">
            <div class="flex gap-2">
                {% if project.githubUrl %}
                    <a href="{{ project.githubUrl }}" target="_blank"
                       class="text-gray-600 hover:text-blue-600 transition">
                        <i class="fab fa-github text-xl"></i>
                    </a>
                {% endif %}

            </div>
{#
            {% if app.user %}
                <button class="text-red-500 hover:text-red-700 transition">
                    <i class="fas fa-heart text-2xl"></i>
                </button>
            {% else %}
                <button onclick="alert('Please login to add favorites!')"
                        class="text-gray-400 hover:text-red-500 transition">
                    <i class="far fa-heart text-2xl"></i>
                </button>
            {% endif %}#}
        </div>
    </div>
</div>
