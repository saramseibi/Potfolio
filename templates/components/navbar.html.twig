<nav class="bg-white shadow-lg sticky top-0 z-50" data-controller="navbar">
    <div class="container mx-auto px-6 py-4">
        <div class="flex items-center justify-between">

            <div class="text-2xl font-bold text-gray-800">
                <a href="/home" class="hover:text-blue-600 transition duration-300">
                    <i class="fas fa-code text-blue-600"></i>
                    <span class="ml-2">Your Name</span>
                </a>
            </div>


            <div class="hidden md:flex items-center space-x-8">
                <a href="#about" class="nav-link text-gray-700 hover:text-blue-600 transition font-medium">
                    About Me
                </a>
                <a href="#projects" class="nav-link text-gray-700 hover:text-blue-600 transition font-medium">
                    Projects
                </a>
                <a href="#skills" class="nav-link text-gray-700 hover:text-blue-600 transition font-medium">
                    Skills
                </a>
                <a href="#contact" class="nav-link text-gray-700 hover:text-blue-600 transition font-medium">
                    Contact
                </a>
            </div>

            {# Authentication Buttons #}
            <div class="hidden md:flex items-center space-x-4">
                {% if app.user %}
                    {# Authenticated State #}
                    <div class="relative" data-navbar-target="dropdown">
                        <button
                            data-action="click->navbar#toggleDropdown"
                            class="flex items-center space-x-2 text-gray-700 hover:text-blue-600 transition">
                            <img src="{{ app.user ? app.user.avatar : '' }}"
                                 alt="{{ app.user ? app.user.username : 'User' }}"
                                 class="w-10 h-10 rounded-full border-2 border-blue-600 object-cover">
                            <span class="font-medium">{{ app.user.username }}</span>
                            <i class="fas fa-chevron-down text-sm"></i>
                        </button>

                        {# Dropdown Menu #}
                        <div data-navbar-target="dropdownMenu"
                             class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-xl py-2 z-50">
                            <a href="#" class="block px-4 py-2 text-gray-800 hover:bg-blue-50 transition">
                                <i class="fas fa-user mr-2"></i>Profile
                            </a>
                            <a href="#" class="block px-4 py-2 text-gray-800 hover:bg-blue-50 transition">
                                <i class="fas fa-cog mr-2"></i>Settings
                            </a>
                            <hr class="my-2">
                            <a href="/logout" class="block px-4 py-2 text-red-600 hover:bg-red-50 transition">
                                <i class="fas fa-sign-out-alt mr-2"></i>Sign Out
                            </a>
                        </div>
                    </div>
                {% else %}
                    {# Guest State #}
                    <a href="/login"
                       class="px-6 py-2 border-2 border-blue-600 text-blue-600 rounded-lg font-medium hover:bg-blue-50 transition duration-200">
                        Sign In
                    </a>
                    <a href="/register"
                       class="px-6 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 shadow-md transition duration-200">
                        Sign Up
                    </a>
                {% endif %}
            </div>


            <button
                data-action="click->navbar#toggleMobile"
                class="md:hidden text-gray-700 hover:text-blue-600 focus:outline-none">
                <i class="fas fa-bars text-2xl"></i>
            </button>
        </div>


        <div data-navbar-target="mobileMenu" class="hidden md:hidden mt-4 pb-4">
            <div class="flex flex-col space-y-4">
                <a href="#about" class="text-gray-700 hover:text-blue-600 transition">
                    About Me
                </a>
                <a href="#projects" class="text-gray-700 hover:text-blue-600 transition">
                    Projects
                </a>
                <a href="#skills" class="text-gray-700 hover:text-blue-600 transition">
                    Skills
                </a>
                <a href="#contact" class="text-gray-700 hover:text-blue-600 transition">
                    Contact
                </a>

                <hr class="my-4">

                {% if app.user %}
                    <span class="text-gray-600">Hello, {{ app.user.username }}! </span>
                    <a href="/logout" class="text-red-600 hover:text-red-700">
                        Sign Out
                    </a>
                {% else %}
                    <a href="/login" class="text-blue-600 font-medium">
                        Sign In
                    </a>
                    <a href="/register" class="text-blue-600 font-medium">
                        Sign Up
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>
