{% extends 'base.html.twig' %}

{% block title %}Project{% endblock %}

{% block body %}
    <h1>Project</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ project.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ project.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ project.description }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ project.image }}</td>
            </tr>
            <tr>
                <th>Technologies</th>
                <td>{{ project.technologies }}</td>
            </tr>
            <tr>
                <th>GithubUrl</th>
                <td>{{ project.githubUrl }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_project_controlle_index') }}">back to list</a>

    <a href="{{ path('app_project_controlle_edit', {'id': project.id}) }}">edit</a>

    {{ include('project_controlle/_delete_form.html.twig') }}
{% endblock %}
