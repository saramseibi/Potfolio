{% extends 'base.html.twig' %}
{% block title %}Admin · Projects & Skills{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto px-6 py-8">


        <div class="mb-10 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
                <h2 class="text-xl font-semibold text-gray-800">Projects</h2>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full border-collapse">
                    <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Project
                        </th>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Description
                        </th>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Technologies
                        </th>
                        <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Delet
                        </th>
                        <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Add
                        </th>
                    </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-100">
                    {% for project in projects %}
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 font-medium text-gray-800">
                                {{ project.title }}
                            </td>

                            <td class="px-6 py-4 text-sm text-gray-600">
                                {{ project.description|slice(0, 80) }}
                                {% if project.description|length > 80 %}…{% endif %}
                            </td>

                            <td class="px-6 py-4">
                                <div class="flex flex-wrap gap-2">
                                    {% for tech in project.technologies|split(',') %}
                                        <span class="inline-flex items-center rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-700">
                                        {{ tech|trim }}
                                    </span>
                                    {% endfor %}
                                </div>
                            </td>

                            <td class="px-6 py-4 text-right">
                                <form method="post"
                                      action="{{ path('admin_project_delete', {id: project.id}) }}"
                                      onsubmit="return confirm('Delete this project?');"
                                      class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                                    <button class="rounded-lg bg-red-100 p-2 text-red-600 hover:bg-red-200 transition">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <a href="{{ path('admin_project_new') }}"
                                   class="inline-flex items-center justify-center rounded-lg bg-green-100 p-2
              text-green-600 hover:bg-green-200 transition"
                                   title="Add new skill">
                                    <i class="bi bi-plus-lg"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="px-6 py-10 text-center text-sm text-gray-500">
                                No projects found
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>


        <h2 class="mb-4 text-xl font-semibold text-gray-800">Skills</h2>

        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
                <table class="min-w-full border-collapse">
                    <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 w-48">
                            Category
                        </th>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Skill
                        </th>
                        <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-500 w-24">
                            Delet
                        </th>
                        <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-500 w-24">
                            Add
                        </th>
                    </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-100">
                    {% for category, skills in skillsByCategory %}
                        {% for skill in skills %}
                            <tr class="hover:bg-gray-50 transition">

                                {% if loop.first %}
                                    <td rowspan="{{ skills|length }}"
                                        class="px-6 py-4 align-middle font-medium text-gray-500 bg-gray-50">
                                        {{ category }}
                                    </td>
                                {% endif %}

                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        {% if skill.icon %}
                                            <i class="{{ skill.icon }} text-lg text-gray-600"></i>
                                        {% endif %}
                                        <span class="font-medium text-gray-800">
                                        {{ skill.name }}
                                    </span>
                                    </div>
                                </td>

                                <td class="px-6 py-4 text-right">
                                    <form method="post"
                                          action="{{ path('admin_skill_delete', {id: skill.id}) }}"
                                          onsubmit="return confirm('Delete this skill?');"
                                          class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ skill.id) }}">
                                        <button class="rounded-lg bg-red-100 p-2 text-red-600 hover:bg-red-200 transition">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <a href="{{ path('admin_skill_new') }}"
                                       class="inline-flex items-center justify-center rounded-lg bg-green-100 p-2
              text-green-600 hover:bg-green-200 transition"
                                       title="Add new skill">
                                        <i class="bi bi-plus-lg"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="3" class="px-6 py-8 text-center text-sm text-gray-500">
                                No skills found
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>


        <div class="mt-8 flex justify-end">
            <a href="{{ path('admin_dashboard') }}"
               class="inline-flex items-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-700 transition">
                 Back
            </a>
        </div>

    </div>
{% endblock %}
