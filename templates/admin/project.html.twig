{% extends 'base.html.twig' %}

{% block body %}
    <div class="max-w-3xl mx-auto pt-20 px-6">

        <div class="rounded-3xl bg-white p-10 shadow-xl ring-1 ring-gray-200">

            <!-- Header -->
            <div class="mb-10">
                <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                    Add New Project
                </h1>
                <p class="mt-2 text-sm text-gray-500">
                    Fill in the details below to create a new project.
                </p>
            </div>

            {{ form_start(form, {
                action: path('admin_project_new'),
                method: 'POST',
                attr: {'class': 'space-y-8'}
            }) }}

            <!-- Title -->
            <div>
                {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
                {{ form_widget(form.title, {
                    'attr': {
                        'class': 'w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3
                              focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition'
                    }
                }) }}
                {{ form_errors(form.title) }}
            </div>

            <!-- Description -->
            <div>
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
                {{ form_widget(form.description, {
                    'attr': {
                        'class': 'w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 h-36
                              focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition'
                    }
                }) }}
                {{ form_errors(form.description) }}
            </div>

            <!-- Technologies -->
            <div>
                {{ form_label(form.technologies, null, {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
                {{ form_widget(form.technologies, {
                    'attr': {
                        'class': 'w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3
                              focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition',
                        'placeholder': 'Symfony, Tailwind, Docker...'
                    }
                }) }}
                {{ form_errors(form.technologies) }}
            </div>

            <!-- GitHub URL -->
            <div>
                {{ form_label(form.githubUrl, null, {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
                {{ form_widget(form.githubUrl, {
                    'attr': {
                        'class': 'w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3
                              focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition',
                        'placeholder': 'https://github.com/username/repo'
                    }
                }) }}
                {{ form_errors(form.githubUrl) }}
            </div>

            <!-- Image -->
            <div>
                {{ form_label(form.imageFile, 'Project Image', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-3'}}) }}

                <div class="flex items-center justify-center rounded-xl border-2 border-dashed border-gray-300 bg-gray-50 px-6 py-8 hover:border-blue-400 transition">
                    {{ form_widget(form.imageFile, {
                        'attr': {
                            'class': 'block w-full text-sm text-gray-500
                                  file:mr-4 file:py-3 file:px-5
                                  file:rounded-xl file:border-0
                                  file:text-sm file:font-semibold
                                  file:bg-blue-100 file:text-blue-700
                                  hover:file:bg-blue-200 transition'
                        }
                    }) }}
                </div>

                {{ form_errors(form.imageFile) }}
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-4 border-t pt-6">
                <a href="{{ path('admin_projects') }}"
                   class="inline-flex items-center rounded-xl border border-gray-300 px-6 py-3
                      text-gray-700 hover:bg-gray-50 transition">
                    Cancel
                </a>

                <button type="submit"
                        class="inline-flex items-center rounded-xl bg-blue-600 px-8 py-3
                           font-semibold text-white shadow-lg hover:bg-blue-700 transition">
                    Save Project
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
