<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Portfolio{% endblock %}</title>

    <meta name="description" content="{% block description %}Professional portfolio showcasing my work and skills{% endblock %}">


    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">


    <script src="https://cdn.tailwindcss.com"></script>


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#2563eb',
                        secondary: '#7c3aed',
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-gray-50 text-gray-900">


{% include 'components/navbar.html.twig' %}


<div class="container mx-auto px-6 mt-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} p-4 rounded-lg text-white mb-4
                            {{ label == 'success' ? 'bg-green-500' : 'bg-red-500' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
</div>

{# Main Content #}
{% block body %}{% endblock %}

</body>
</html>
